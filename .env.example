# ── Neon Postgres ────────────────────────────────────────────────────────────
# Use the POOLED connection string (host contains "-pooler"). The app uses the
# Neon WebSocket driver, which needs the pooler for interactive transactions.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Clerk ────────────────────────────────────────────────────────────────────
# Dashboard → API keys. Remember to enable Restricted mode under
# Configure → Restrictions, or anyone can sign up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# ── ESPN (server-only; never expose to the client) ───────────────────────────
# Private league, so these are required for any sync.
# Grab from a logged-in browser: DevTools → Application → Cookies → espn.com
# SWID includes its surrounding braces. espn_s2 is ~250 chars, URL-encoded.
# These rot on ESPN password change or logout — sync surfaces a banner on 401.
ESPN_LEAGUE_ID="718396"
ESPN_S2=""
ESPN_SWID=""
